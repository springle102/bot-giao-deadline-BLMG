# Discord Bot Token - Lấy từ https://discord.com/developers/applications
DISCORD_TOKEN=
# Bot Client ID - Lấy từ Discord Developer Portal > Application > General Information
CLIENT_ID=

# Server (Guild) ID mục tiêu để sync command trực tiếp (nên là server dùng chung)
GUILD_ID=

# Bật để Discord cập nhật slash command/option sau mỗi lần bot khởi động.
FORCE_COMMAND_SYNC_ON_STARTUP=1

# Admin Role ID / User ID - Hỗ trợ Role ID, User ID, hoặc Tên Role (Có thể nhập nhiều ID phân cách bởi dấu phẩy)
ADMIN_ROLE_ID=
# Tùy chọn: Nhập User ID trực tiếp của Quản lý nếu muốn gán quyền Admin theo tài khoản cá nhân
ADMIN_USER_ID=

# Render Deploy Hook URL (Settings > Deploy Hook). Chỉ ADMIN_USER_ID mới dùng được /deploy.
RENDER_DEPLOY_HOOK_URL=
# Render API key (Account Settings > API Keys), dùng để theo dõi deploy đến khi hoàn tất.
RENDER_API_KEY=
# Service ID của service bot (dạng srv-...).
RENDER_SERVICE_ID=

# Channel ID để bot giao deadline - Click phải vào channel > Copy Channel ID
DEADLINE_CHANNEL_ID=

# Tùy chọn: Nhập trực tiếp chuỗi JSON nội dung file credentials.json (Dành cho Hosting online như Render, Replit mà không cần push file credentials.json lên Git)
GOOGLE_CREDENTIALS_JSON=

# Tùy chọn: Đường dẫn lưu file CSDL SQLite (Dành cho Hosting có đĩa lưu trữ Persistent Disk như Render/Railway, ví dụ: /var/data/deadline_bot.db)
DB_PATH=deadline_bot.db


